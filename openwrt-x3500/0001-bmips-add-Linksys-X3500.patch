diff --git a/target/linux/bmips/patches-6.6/120-pinctrl-bcm6362-fix-gpio-mode-mask.patch b/target/linux/bmips/patches-6.6/120-pinctrl-bcm6362-fix-gpio-mode-mask.patch
new file mode 100644
index 0000000..e79b495
--- /dev/null
+++ b/target/linux/bmips/patches-6.6/120-pinctrl-bcm6362-fix-gpio-mode-mask.patch
@@ -0,0 +1,26 @@
+From: Linksys X3500 port <noreply@example.invalid>
+Subject: [PATCH] pinctrl: bcm: bcm6362: fix GPIO mode mask
+
+bcm6362_set_gpio() passes the bank pin *number* returned by
+bcm63xx_bank_pin() directly as the mask to regmap_update_bits(), instead
+of the bit for that pin. As a result, requesting a pin as GPIO clears
+the wrong bits in the MODE/LED/CTRL registers and leaves the pin muxed
+to its previous function. E.g. on the Linksys X3500 the bootloader muxes
+GPIO 12-17 to the LED controller, and these pins could not be driven as
+GPIOs afterwards (LED register stayed at 0x000370e0).
+
+Use BIT() like bcm63268_set_gpio() does.
+
+Fixes: 705791e23ecd ("pinctrl: add a pincontrol driver for BCM6362")
+---
+--- a/drivers/pinctrl/bcm/pinctrl-bcm6362.c
++++ b/drivers/pinctrl/bcm/pinctrl-bcm6362.c
+@@ -484,7 +484,7 @@
+ {
+ 	const struct pinctrl_pin_desc *desc = &bcm6362_pins[pin];
+ 	unsigned int basemode = (uintptr_t)desc->drv_data;
+-	unsigned int mask = bcm63xx_bank_pin(pin);
++	unsigned int mask = BIT(bcm63xx_bank_pin(pin));
+ 
+ 	if (basemode)
+ 		regmap_update_bits(pc->regs, BCM6362_BASEMODE_REG, basemode, 0);
